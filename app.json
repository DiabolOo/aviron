{
  "expo": {
    "name": "PulseFit",
    "slug": "pulsefit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pulsefit",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "PulseFit utilise la caméra pour scanner tes repas.",
        "NSPhotoLibraryUsageDescription": "PulseFit importe une photo d’assiette depuis ta galerie."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0F1C"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PulseFit utilise la caméra pour scanner tes repas."
        }
      ],
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
